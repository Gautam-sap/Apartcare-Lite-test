# Clean local development: Next.js proxies /api/* to FastAPI automatically.
# Leave NEXT_PUBLIC_API_BASE empty for local development.
NEXT_PUBLIC_API_BASE=

# Optional: use a project-local state file instead of the default runtime path.
APARTCARE_RUNTIME_DIR=./backend/runtime
APARTCARE_STATE_FILE=./backend/runtime/apartcare_state.json

# Optional SMTP settings for welcome/password-reset email testing.
APARTCARE_SMTP_SENDER=
APARTCARE_SMTP_EMAIL=
APARTCARE_SMTP_HOST=smtp.gmail.com
APARTCARE_SMTP_PORT=587
APARTCARE_SMTP_APP_PASSWORD=
