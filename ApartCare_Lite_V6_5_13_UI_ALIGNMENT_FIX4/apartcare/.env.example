# Frontend/API routing
# Leave blank for the Vercel same-origin deployment (/api).
NEXT_PUBLIC_API_BASE=

# Production browser origins
CORS_ALLOWED_ORIGINS=https://www.apartcarelite.com,https://apartcarelite.com

# Production persistence: connect a Postgres database (recommended: Neon via Vercel Marketplace).
# V6.5.13 stores the complete application state as a single JSONB document in Postgres.
# Leave APARTCARE_STATE_FILE blank in production.
DATABASE_URL=
APARTCARE_STATE_FILE=
APARTCARE_UPLOAD_DIR=

# Optional Razorpay settings
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Vercel Blob private storage for apartment logos and expense receipts.
# Create a PRIVATE Blob store in Vercel and connect it to this project.
BLOB_READ_WRITE_TOKEN=
